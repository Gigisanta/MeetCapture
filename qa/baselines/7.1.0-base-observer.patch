+    /// `phys_footprint` is the figure Activity Monitor reports as Memory; RSS
+    /// also counts clean pages the kernel can drop, so it is not used here.
+    private static func memorySample(_ label: String, since start: Date) -> [String: Any] {
+        var info = task_vm_info_data_t()
+        var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+        let status = withUnsafeMutablePointer(to: &info) {
+            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+            }
+        }
+        var sample: [String: Any] = ["label": label, "elapsedSec": Date().timeIntervalSince(start)]
+        if status == KERN_SUCCESS {
+            sample["physFootprintBytes"] = info.phys_footprint
+            sample["residentBytes"] = info.resident_size
+        }
+        return sample
+    }
+
+    /// Peak RSS of reaped child processes (bytes on macOS); 0 without children.
+    private static func childrenMaxRSS() -> Int {
+        var usage = rusage()
+        guard getrusage(RUSAGE_CHILDREN, &usage) == 0 else { return -1 }
+        return usage.ru_maxrss
+    }
